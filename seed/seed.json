    "pages": [
      {
        "id": "home",
        "slug": "home",
        "status": "published",
        "data": {
          "title": "A little Hong Kong.",
          "highlight": "A lot of heart.",
          "eyebrow": "HONG KONG & MACAU · MADE IN MALAYSIA",
          "lead": "From sizzling seafood to slow-cooked congee, discover the flavours of Hong Kong and Macau in Genting Highlands.",
          "action": "Explore our restaurants",
          "secondary": "Find a location",
          "section_title": "Find your flavour.",
          "section_lead": "Three dining experiences, each with its own take on the flavours and spirit of Hong Kong and Macau.",
          "feature_title": "A taste of DAFU.",
          "feature_lead": "From seafood to a warm bowl of congee, see what’s on the table.",
          "title_zh": "香港风味。",
          "highlight_zh": "满满人情味。",
          "eyebrow_zh": "香港与澳门风味 · 马来西亚呈献",
          "lead_zh": "从热腾腾的海鲜到慢熬生滚粥，在云顶高原品尝香港和澳门风味。",
          "action_zh": "探索餐厅",
          "secondary_zh": "查找门店",
          "section_title_zh": "找到你的心头好。",
          "section_lead_zh": "三种餐饮体验，各自呈现港澳的风味与生活气息。",
          "feature_title_zh": "大福风味。",
          "feature_lead_zh": "从鲜美海鲜到一碗热粥，看看大福餐桌上的风味。"
        }
      },
      {
        "id": "about",
        "slug": "about",
        "status": "published",
        "data": {
          "title": "Good food brings us together.",
          "eyebrow": "OUR STORY",
          "lead": "A Malaysian restaurant group with a love for the food and hospitality of Hong Kong and Macau.",
          "body": "DAFU 大福 brings the bustle of a Hong Kong dai pai dong, the comfort of a Macau congee shop and the energy of Lan Kwai Fong to Malaysia.\n\nFrom a quick bowl on a cool Genting morning to a seafood feast with friends, we build our restaurants around the way people like to eat together.",
          "title_zh": "好味道，让我们相聚。",
          "eyebrow_zh": "品牌故事",
          "lead_zh": "大福是一个马来西亚餐饮集团，热爱香港与澳门的美食和待客之道。",
          "body_zh": "大福把香港大排档的热闹、澳门粥店的暖意与兰桂坊的夜生活带到马来西亚。\n\n无论是在清凉的云顶早晨吃一碗热粥，还是与好友分享一桌海鲜，我们都希望每一家大福餐厅都能成为相聚的好地方。"
        }
      },
      {
        "id": "restaurants",
        "slug": "restaurants",
        "status": "published",
        "data": {
          "title": "Find your flavour.",
          "eyebrow": "OUR RESTAURANTS",
          "lead": "Explore DAFU’s Hong Kong and Macau-inspired dining concepts, from Cantonese seafood to bowls of Macau-style congee.",
          "title_zh": "找到你的心头好。",
          "eyebrow_zh": "大福餐厅",
          "lead_zh": "探索大福的港澳餐饮概念，从粤式海鲜到澳门风味生滚粥。"
        }
      },
      {
        "id": "news",
